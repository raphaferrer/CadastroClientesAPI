@model ClienteViewModel

@{
    ViewData["Title"] = "Cadastrar Cliente";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <h2>Cadastrar Cliente</h2>

    <form asp-controller="Cliente" asp-action="Create" method="post" enctype="multipart/form-data">
        <div class="mb-3">
            <label class="form-label">Nome</label>
            <input type="text" class="form-control" asp-for="Nome" required>
            <span class="text-danger" asp-validation-for="Nome"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Email</label>
            <input type="email" class="form-control" asp-for="Email" required>
            <span class="text-danger" asp-validation-for="Email"></span>
        </div>

        <div class="mb-3">
            <label class="form-label">Logotipo</label>
            <input type="file" class="form-control" asp-for="Logotipo">
            <span class="text-danger" asp-validation-for="Logotipo"></span>
        </div>

        <button type="submit" class="btn btn-success">Salvar</button>
    </form>
</div>
