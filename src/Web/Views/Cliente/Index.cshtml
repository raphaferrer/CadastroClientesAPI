@model List<ClienteViewModel>

@{
    ViewData["Title"] = "Lista de Clientes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">
    <h2 class="mt-4">Clientes</h2>
    <a class="btn btn-primary mb-3" asp-controller="Cliente" asp-action="Create">Cadastrar Cliente</a>

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Email</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cliente in Model)
            {
                <tr>
                    <td>@cliente.Nome</td>
                    <td>@cliente.Email</td>
                    <td>
                        <a class="btn btn-info" asp-action="Edit" asp-route-email="@cliente.Email">Editar</a>
                        <a class="btn btn-danger" asp-action="Delete" asp-route-email="@cliente.Email">Excluir</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
